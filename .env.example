# Copier en .env.local (sur l'ordinateur) ou saisir dans Vercel > Settings > Environment Variables.
# Sans les deux variables Supabase, l'appli tourne en mode démo (chaque téléphone garde ses données).

# Supabase > Project Settings > API (ou bouton « Connect »)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Ne JAMAIS mettre ici la clé « service_role » (ou « secret ») : elle contourne toutes les protections.

# Adresse publique du site, pour les aperçus WhatsApp
NEXT_PUBLIC_SITE_URL=https://servilink.vercel.app

# Bunny Stream (facultatif : sans ces trois variables, les vidéos vont dans Supabase Storage)
# Stream > votre bibliothèque > API : « Video Library ID » et « API Key » (SECRÈTE : jamais NEXT_PUBLIC)
BUNNY_STREAM_LIBRARY_ID=123456
BUNNY_STREAM_API_KEY=xxxxxxxx-xxxx-xxxx-xxxxxxxxxxxx-xxxx-xxxx
# Stream > votre bibliothèque > API : « CDN Hostname », sans https://
NEXT_PUBLIC_BUNNY_CDN=vz-xxxxxxxx-xxx.b-cdn.net
